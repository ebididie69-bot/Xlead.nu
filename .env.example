# Copy to .env and fill in. Never commit the real .env file.

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The ONE Google account allowed to sign in as admin
ADMIN_EMAIL=you@gmail.com

# Where the React app runs (used for CORS + OAuth redirect + session cookie).
# Local dev: http://localhost:5173
# Production (Vercel): the exact Vercel URL, no trailing slash —
#   e.g. https://leadforge-ai.vercel.app
FRONTEND_URL=http://localhost:5173

# sqlite:///./leadforge.db for local dev.
# On Railway: add a Postgres plugin, then set this to its connection string
# (Railway injects DATABASE_URL automatically if the Postgres plugin is
# attached to this service — you often don't need to set this by hand).
DATABASE_URL=sqlite:///./leadforge.db

# development locally; production on Railway.
# This also controls the session cookie: production uses SameSite=None +
# Secure (required for the cross-domain Vercel <-> Railway setup), while
# development uses SameSite=Lax (simpler, works over plain http://localhost).
ENV=development
